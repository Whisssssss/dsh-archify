    "workflow",
    "dataflow",
    "lifecycle",
    "mermaid"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whisssssss/dsh-archify.git",
    "directory": "."
  },
  "homepage": "https://github.com/Whisssssss/dsh-archify",
  "bugs": {
    "url": "https://github.com/Whisssssss/dsh-archify/issues"
  },
